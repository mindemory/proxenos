# Copy to .env (ignored) and fill in. Never commit .env.

# The private vault: raw exports, the self-model, briefs, evals.
# Must be outside this repo, which is public.
TWIN_VAULT=~/twin_vault

# Personal Anthropic API key (console.anthropic.com), separate from any work account.
ANTHROPIC_API_KEY=

# What the twin calls me in its notes and self-model.
TWIN_NAME=

# My addresses across all accounts, comma-separated, so email knows which mail is mine.
TWIN_EMAILS=

# Strava: an app at strava.com/settings/api and a refresh token with activity:read_all.
# After the first run the latest token lives in the vault and this one can be removed.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Slack: a user OAuth token (xoxp-...) from an app at api.slack.com/apps with these user
# scopes: channels:read groups:read im:read mpim:read channels:history groups:history
# im:history mpim:history users:read. Leave token rotation off.
SLACK_USER_TOKEN=
