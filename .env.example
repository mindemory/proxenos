# Copy to .env (ignored) and fill in. Never commit .env.

# Settings are PROXENOS_*. Older TWIN_* names are still read when the new one isn't set.

# The private vault: raw exports, the self-model, briefs, evals.
# Must be outside this repo, which is public.
PROXENOS_VAULT=~/proxenos_vault

# Personal Anthropic API key (console.anthropic.com), separate from any work account.
ANTHROPIC_API_KEY=

# What Proxenos calls you in its notes and self-model.
PROXENOS_NAME=

# Public mentions and published work (news search, OpenAlex). PROXENOS_OPENALEX_ID pins the author
# profile (e.g. A123...) if the name search picks the wrong one.
PROXENOS_FULL_NAME=
PROXENOS_OPENALEX_ID=

# Bluesky handle for reading your public posts.
PROXENOS_BLUESKY_HANDLE=

# Gmail over IMAP, one line per account: GMAIL_<NAME>=address:app-password. NAME names the
# stream (raw/email/<name>). App passwords: myaccount.google.com/apppasswords (needs 2-Step
# Verification); IMAP must be on in Gmail settings. Where app passwords aren't allowed, put a
# Google Cloud "Desktop app" OAuth client below and run `proxenos auth gmail NAME ADDRESS` (or
# sign in from the page's Connect view), which writes GMAIL_<NAME>=address:oauth:<refresh token>
# here.
GMAIL_PERSONAL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your addresses across all accounts, comma-separated, so email knows which mail is yours.
PROXENOS_EMAILS=

# Strava: an app at strava.com/settings/api and a refresh token with activity:read_all.
# After the first run the latest token lives in the vault and this one can be removed.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Slack: either slackdump archives (no token needed; see PROXENOS_SLACKDUMP_DIR below), or a
# user OAuth token (xoxp-...) from an app at api.slack.com/apps with these user scopes:
# channels:read groups:read im:read mpim:read channels:history groups:history im:history
# mpim:history users:read. Leave token rotation off.
SLACK_USER_TOKEN=

# Sources that live in folders on your computer. A leading ~ is expanded. With the Spotify or
# website setting empty, `proxenos sync` and `proxenos night` skip that source.

# Spotify: the folder of your Extended Streaming History export (the one holding
# Streaming_History_Audio_*.json). `proxenos ingest spotify --export DIR` reads another folder
# for one run, and `proxenos import` picks up a fresh download without this setting.
PROXENOS_SPOTIFY_EXPORT=

# Your website: its local git repo, whose pages, posts and CV data are read.
# `proxenos ingest website --repo DIR` reads another repo for one run.
PROXENOS_WEBSITE_REPO=

# slackdump: a folder holding slackdump_* runs. The repo's data/ folder is searched as well, so
# leave this empty if you drop the runs there.
PROXENOS_SLACKDUMP_DIR=

# Optional. PROXENOS_MODEL overrides the model the clones use (the default is in
# src/proxenos/llm.py). PROXENOS_BIN is the path to the proxenos command, for when the page
# can't find it on PATH (it runs it to rebuild the people index).
# PROXENOS_MODEL=
# PROXENOS_BIN=
