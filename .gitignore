# ── Personal data ────────────────────────────────────────────────────────────
# This repo is public and holds code only. Anything that *is* me (exports,
# notes, chat logs, the compiled self-model, embeddings, research briefs)
# lives in the vault, outside this repo (PROXENOS_VAULT in .env). These entries
# are a backstop in case something lands here by mistake.
# Un-ignore individual files deliberately (e.g. fixtures), never whole dirs.
/data/
/vault/
/exports/
*.zip
*.tar.gz
*.tgz
*.mbox
*.vcf

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
/secrets/
*.pem
*.key
credentials*.json
client_secret*.json
token*.json

# ── Local stores, indices, model weights ─────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/chroma_db/
/.chroma/
/.lancedb/
/qdrant_storage/
*.faiss
/models/
/checkpoints/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth

# ── Logs ─────────────────────────────────────────────────────────────────────
/logs/
*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
